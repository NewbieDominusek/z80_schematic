	(text "				ADDRESS SPACE (64kB, divided into 4 main 16kB segments)\n\n0000	- 	3FFF 	EEPROM BIOS\n		0000 - 1FFF BIOS MAIN\n		2000 - 3FFF BIOS PAGED (32 pages, 256kB total memory)\n\n4000 	- 	BFFF	RAM (4 pages, 128kB total memory)\n\nC000	-	FFFF	Misc (I/O, page switching) + LAST 8kB OF RAM (ALWAYS AVAILABLE)\n	I/O chip 1:\n		C000 Port A, Data\n		C001 Port B, Data\n		C002 Port A, Command\n		C003 Port B, Command\n	I/O chip 2:\n		C004 Port A, Data\n		C005 Port B, Data\n		C006 Port A, Command\n		C007 Port B, Command\n	MEMORY PAGE for changing RAM and BIOS\n		C008 Octal D-FlipFlop\n	C009 - DFFF - Unused\n	Last 8kB of RAM\n		E000 - FFFF RAM (1E000	-	1FFFF)"
		(exclude_from_sim no)
