	(text "				ADDRESS SPACE (64kB, divided into 4 main 16kB segments)\n\n0000	- 	3FFF 	EEPROM BIOS\n		0000 - 1FFF BIOS MAIN\n		2000 - 3FFF BIOS PAGED (32 pages, 256kB total memory)\n\n4000 	- 	7FFF	RAM (8 pages, 128kB total memory)\n\n8000	-	BFFF	FLASH program memory (32 pages, 512kB total memory)\n\nC000	-	FFFF	Misc (I/O, page switching) + LAST 8kB OF RAM (ALWAYS AVAILABLE)\n	I/O chip:\n		C000 Port A, Data\n		C001 Port B, Data\n		C002 Port A, Command\n		C003 Port B, Command\n	MEMORY PAGE for changing RAM and FLASH\n		C004 Octal D-FlipFlop\n	BIOS PAGE\n		C005 Octal D-FlipFlop\n	Additional output flatch\n		C006 Octal D-FlipFlop\n	C007 - DFFF - Unused\n	Last 8kB of RAM\n		E000 - FFFF RAM (1E000	-	1FFFF)"
		(exclude_from_sim no)
